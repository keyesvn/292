ADMIN_PASSWORD_HASH=scrypt$16384$8$1$REPLACE_WITH_GENERATED_HASH
KEY_ENCRYPTION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
292VPN_PANEL_API_URL=https://panel.example.com
292VPN_PANEL_API_TOKEN=REPLACE_WITH_XUI_API_TOKEN
# Khuyến nghị dùng username/password để backend tự đăng nhập lại khi session X-UI hết hạn.
292VPN_PANEL_USERNAME=
292VPN_PANEL_PASSWORD=
# Chỉ dùng cho môi trường local đáng tin cậy; production nên để trống.
# 292VPN_ALLOW_INSECURE_HTTP=1

# GPM Software
GPM_EMAIL=
GPM_PASSWORD=
# GPM_API_BASE_URL=https://api.gpmsoftwares.com/api/v1
GPM_AUTO_EXCHANGE=1
GPM_AUTO_EXCHANGE_INTERVAL_MS=60000
GPM_EXPIRING_WINDOW_HOURS=72

# Proton VPN: credential chính được quản lý mã hóa trong database qua admin API.
PROTON_API_BASE_URL=https://account.protonvpn.com
PROTON_APP_VERSION=web-vpn-settings@5.0.347.1
PROTON_AUTO_REVOKE=0
PROTON_AUTO_REVOKE_INTERVAL_MS=3600000
# Có thể để trống. Nếu cấu hình, chỉ dùng làm cookie fallback khi UID trong
# cookie AUTH-<UID> khớp đúng account; helper per-account vẫn được ưu tiên.
PROTON_COOKIE=
PROTON_PASSWORD=
# Helper renew nhận JSON qua stdin, trả JSON {"cookie":"...","uid":"...","appVersion":"..."}.
# PROTON_REFRESH_ARGS là JSON array, ví dụ ["--headless"].
PROTON_REFRESH_COMMAND=/usr/bin/python3
PROTON_REFRESH_ARGS=["/app/scripts/refresh-proton.py"]
PROTON_REFRESH_TIMEOUT_MS=120000

# Không đặt account Proton thật trong file example. Thêm account qua menu Proton
# để cookie/password được mã hóa bằng KEY_ENCRYPTION_SECRET trong SQLite.
